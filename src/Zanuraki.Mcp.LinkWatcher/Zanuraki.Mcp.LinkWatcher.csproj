<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>link-watcher</ToolCommandName>
    <PackageId>Zanuraki.Mcp.LinkWatcher</PackageId>
    <AssemblyName>Zanuraki.Mcp.LinkWatcher</AssemblyName>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>MCP server that watches bug reports, support issues and feature requests and reports what changed.</Description>
    <Authors>Zanuraki</Authors>
    <RepositoryUrl>https://github.com/zanuraki/mcp-link-watcher</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="11.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.3.26207.106" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
